# Copy to .env and adjust. Never commit a real .env.
FLOWGUARD_ENV=development
# Long random value in production (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
FLOWGUARD_SECRET_KEY=change-me
DATABASE_URL=sqlite:///./flowguard.db
# DATABASE_URL=postgresql+psycopg://flowguard:password@db:5432/flowguard
FLOWGUARD_COOKIE_SECURE=false        # true behind HTTPS
FLOWGUARD_SESSION_HOURS=8
FLOWGUARD_PBKDF2_ITERATIONS=600000
FLOWGUARD_LOGIN_ATTEMPTS_PER_15MIN=10
FLOWGUARD_MAX_UPLOAD_BYTES=10485760
# Business date for pricing checks. Leave empty to use today's date (admins can also set it in Settings).
FLOWGUARD_BUSINESS_DATE=
# Password for the first Super Admin ('admin'), used only when the database has no users yet.
FLOWGUARD_ADMIN_PASSWORD=
# Local AI. No model name is hardcoded: leave OLLAMA_MODEL empty to use the first local model.
FLOWGUARD_AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=20
